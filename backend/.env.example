DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only needed if the frontend is ever served from a different origin than
# this backend (not the case for the default arxinfo.tech single-app setup
# — see DEPLOY.md). Comma-separated, each with scheme, e.g.:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://arxinfo.tech,https://www.arxinfo.tech
DJANGO_CSRF_TRUSTED_ORIGINS=

# Set DB_ENGINE=mysql to use MySQL instead of the SQLite dev default
DB_ENGINE=sqlite
DB_NAME=arx_infotech
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Production values for arxinfo.tech (see DEPLOY.md) ---
# DJANGO_SECRET_KEY=<generate one, don't reuse this dev value>
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=arxinfo.tech,www.arxinfo.tech
# DB_ENGINE=mysql
# DB_NAME=<cPanel MySQL database name>
# DB_USER=<cPanel MySQL user>
# DB_PASSWORD=<cPanel MySQL password>
# DB_HOST=localhost
# DB_PORT=3306
